# Flutter
.dart_tool/
.packages
build/
*.iml
.idea/
.vscode/
*.lock
# Apps commit their lock file: exact dependency versions (F-Droid scanner requires it).
!pubspec.lock

# Android
android/.gradle/
android/app/build/
android/local.properties
android/key.properties
*.jks
*.keystore

# iOS
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec

# OS
.DS_Store
Thumbs.db

# Misc
*.log
*.tmp
coverage/
.aider*

# Never commit third-party service configs (F-Droid is FOSS-only)
lib/firebase_options.dart
firebase.json
firestore.rules
firestore.indexes.json
.firebaserc
google-services.json
.sentry-native/

# Generated by Flutter, contains absolute local paths
.flutter-plugins-dependencies
.flutter-plugins

# Windows release packages (windows/packaging/build_release.ps1)
/dist/
